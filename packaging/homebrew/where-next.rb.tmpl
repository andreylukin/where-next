# Homebrew formula template for where-next. NOT PUBLISHED: no tap exists yet.
#
# At release time, fill in @VERSION@ and the per-target @SHA256_*@ values from SHA256SUMS
# (release workflow artifact), then commit this as Formula/where-next.rb in a tap repository
# (andreylukin/homebrew-tap) so users can `brew install andreylukin/tap/where-next`.
class WhereNext < Formula
  desc "Fast local \"where next\" hints for coding agents and developers"
  homepage "https://github.com/andreylukin/where-next"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/andreylukin/where-next/releases/download/v@VERSION@/wn-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/andreylukin/where-next/releases/download/v@VERSION@/wn-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/andreylukin/where-next/releases/download/v@VERSION@/wn-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/andreylukin/where-next/releases/download/v@VERSION@/wn-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "wn"
  end

  def caveats
    <<~EOS
      The model is downloaded separately on first use and has its own license terms.
      Run `wn model pull <name> --source <source>` or see docs/install.md.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/wn --version")
  end
end
